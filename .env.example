# ============================================================
# MAJOR RUN — full training run
# ============================================================

BOARD_SIZE=4
SEED=42

GAMMA=0.99
LEARNING_RATE=1e-4
BATCH_SIZE=64
REPLAY_CAPACITY=100000
MIN_REPLAY_SIZE=2000

EPSILON_START=1.0
EPSILON_END=0.01
EPSILON_DECAY=50000

N_STEPS=5
TAU=0.005
TRAINING_STEPS=200000
EVAL_EVERY=10000
EVAL_EPISODES=100

HIDDEN_DIM=256
GRAD_CLIP_NORM=10.0

CHECKPOINT_DIR=checkpoints
OUTPUT_DIR=output
