BOARD_SIZE=4
SEED=42

GAMMA=0.99
LEARNING_RATE=1e-4
BATCH_SIZE=64
REPLAY_CAPACITY=50000
MIN_REPLAY_SIZE=2000

EPSILON_START=1.0
EPSILON_END=0.01
EPSILON_DECAY=10000

TARGET_UPDATE_FREQUENCY=1000
TRAINING_STEPS=100000
EVAL_EVERY=5000
EVAL_EPISODES=100

HIDDEN_DIM=128

CHECKPOINT_DIR=checkpoints
OUTPUT_DIR=output
