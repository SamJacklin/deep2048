BOARD_SIZE=4
SEED=42

GAMMA=0.99
LEARNING_RATE=5e-5
BATCH_SIZE=128
REPLAY_CAPACITY=250000
MIN_REPLAY_SIZE=5000

EPSILON_START=1.0
EPSILON_END=0.01
EPSILON_DECAY=700000

TAU=1.0
TARGET_UPDATE_FREQUENCY=1000
TRAINING_STEPS=1000000
EVAL_EVERY=25000
EVAL_EPISODES=100

HIDDEN_DIM=1024

N_STEPS=5
MILESTONE_BONUS_SCALE=3.0

CHECKPOINT_DIR=checkpoints/dqn
OUTPUT_DIR=output/dqn
